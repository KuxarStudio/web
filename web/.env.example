# Google Analytics 4 measurement ID (formato G-XXXXXXX).
# Déjalo vacío/sin definir para que la web funcione sin GA4 (el componente
# Analytics.astro simplemente no renderiza nada si esta variable no existe).
#
# En local: copia este archivo a .env y rellena el valor para probar GA4 en dev.
# En producción (GitHub Actions): se define como repo variable PUBLIC_GA_ID
# en Settings → Secrets and variables → Actions → Variables, no aquí.
PUBLIC_GA_ID=

# Access key de Web3Forms (https://web3forms.com) para el formulario de
# contacto — gratis, sin backend propio, protección anti-spam incluida.
# Déjalo vacío/sin definir para que la web funcione sin formulario (se
# muestra en su lugar un aviso con el email de contacto).
PUBLIC_WEB3FORMS_KEY=

# Cloudflare Turnstile — site key del captcha del formulario de contacto.
# Pública por naturaleza (aparece en el HTML). La SECRET key NO va aquí: se
# pega en el panel de Web3Forms, que valida el token en su servidor. Sin esta
# variable, el formulario funciona igual pero sin captcha (solo honeypot).
# En producción se define como repo variable PUBLIC_TURNSTILE_SITE_KEY.
PUBLIC_TURNSTILE_SITE_KEY=
