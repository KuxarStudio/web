---
// Formulario de contacto sin backend propio, vía Web3Forms
// (https://web3forms.com — gratis hasta 250 envíos/mes, con protección
// anti-spam del lado del servidor). Si no hay access key configurada,
// se muestra un aviso con el email de contacto en su lugar, para que el
// build nunca dependa de tener la key para funcionar.
import type { Lang } from '../i18n';

interface Props {
  /** Muestra el email como alternativa si no hay access key. Desactívalo si
   *  el contenedor ya enseña el email (p. ej. el footer). */
  fallback?: boolean;
  lang?: Lang;
}
const { fallback = true, lang = 'es' } = Astro.props;
const t = {
  es: {
    name: 'Nombre', email: 'Email', message: 'Mensaje', send: 'Enviar', sending: 'Enviando…',
    ok: 'Mensaje enviado. Te responderemos por email lo antes posible.',
    okBot: 'Mensaje enviado. Te responderemos por email.',
    fail: 'No se pudo enviar el mensaje. Prueba de nuevo o escríbenos a admin@kuxarstudio.com.',
    subject: 'Nuevo mensaje desde kuxarstudio.com', from: 'Formulario de kuxarstudio.com',
    honey: 'No rellenar este campo', direct: 'Escríbenos directamente a',
    parteSubject: 'Solicitud de acceso anticipado a Parte',
    parteMessage: 'Me interesa Parte. Mi empresa se dedica a ',
  },
  en: {
    name: 'Name', email: 'Email', message: 'Message', send: 'Send', sending: 'Sending…',
    ok: "Message sent. We'll reply by email as soon as we can.",
    okBot: "Message sent. We'll reply by email.",
    fail: 'The message could not be sent. Try again or write to us at admin@kuxarstudio.com.',
    subject: 'New message from kuxarstudio.com (English page)', from: 'kuxarstudio.com form (EN)',
    honey: 'Leave this field empty', direct: 'Write to us directly at',
    parteSubject: 'Early access request for Parte (English page)',
    parteMessage: "I'm interested in Parte. My company does ",
  },
}[lang];
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
---
{accessKey ? (
  <form id="contact-form" class="contact-form" novalidate data-sending={t.sending} data-send={t.send} data-ok={t.ok} data-ok-bot={t.okBot} data-fail={t.fail} data-parte-subject={t.parteSubject} data-parte-message={t.parteMessage}>
    <input type="hidden" name="access_key" value={accessKey} />
    <input type="hidden" name="subject" id="cf-subject" value={t.subject} />
    <input type="hidden" name="from_name" value={t.from} />

    {/* Honeypot: campo invisible para humanos. Si llega relleno, es un bot. */}
    <div class="contact-honeypot" aria-hidden="true">
      <label for="cf-website">{t.honey}</label>
      <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-field">
      <label for="cf-name">{t.name}</label>
      <input type="text" id="cf-name" name="name" required maxlength="100" autocomplete="name" />
    </div>
    <div class="form-field">
      <label for="cf-email">{t.email}</label>
      <input type="email" id="cf-email" name="email" required maxlength="200" autocomplete="email" spellcheck="false" />
    </div>
    <div class="form-field">
      <label for="cf-message">{t.message}</label>
      <textarea id="cf-message" name="message" required maxlength="5000"></textarea>
    </div>

    <button type="submit" class="btn btn-primary" id="cf-submit">{t.send}</button>
    <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
  </form>
) : fallback && (
  <p class="contact-fallback">
    {t.direct} <a href="mailto:admin@kuxarstudio.com">admin@kuxarstudio.com</a>.
  </p>
)}

<script>
  (function () {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form) return;

    const statusEl = document.getElementById('cf-status')!;
    const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement;

    // ?asunto=parte (botones "Pedir acceso" de Parte) etiqueta el email para
    // distinguir las solicitudes de acceso del resto de mensajes.
    if (new URLSearchParams(window.location.search).get('asunto') === 'parte') {
      const subjectInput = document.getElementById('cf-subject') as HTMLInputElement | null;
      const messageInput = document.getElementById('cf-message') as HTMLTextAreaElement | null;
      if (subjectInput) subjectInput.value = form.dataset.parteSubject || subjectInput.value;
      if (messageInput && !messageInput.value) messageInput.value = form.dataset.parteMessage || '';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      // Honeypot: si el campo trampa viene relleno, es un bot. Fingimos
      // éxito para no darle pistas de que fue detectado, y no enviamos nada.
      const honeypot = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (honeypot && honeypot.value.trim() !== '') {
        statusEl.textContent = form.dataset.okBot || '';
        statusEl.className = 'form-status success';
        form.reset();
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = form.dataset.sending || '';
      statusEl.textContent = '';
      statusEl.className = 'form-status';

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (data.success) {
          statusEl.textContent = form.dataset.ok || '';
          statusEl.className = 'form-status success';
          form.reset();
        } else {
          throw new Error(data.message || 'Error desconocido');
        }
      } catch (err) {
        statusEl.textContent = form.dataset.fail || '';
        statusEl.className = 'form-status error';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = form.dataset.send || '';
      }
    });
  })();
</script>
