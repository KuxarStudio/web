---
import type { CollectionEntry } from 'astro:content';
import type { RepoStats } from '../lib/github';
import PhoneVideo from './PhoneVideo.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  stats?: RepoStats | null;
  featured?: boolean;
}
const { project, featured = false } = Astro.props;
const { title, category, status, description, stack, media, progress, googlePlay, appStore, steam, repo, devlog } =
  project.data;
const base = import.meta.env.BASE_URL;

const categoryLabel: Record<string, string> = { juego: 'Juego', aprendizaje: 'App de aprendizaje' };
const statusLabel: Record<string, string> = {
  'en-desarrollo': 'En desarrollo',
  proximamente: 'Próximamente',
  disponible: 'Disponible',
};

// Un enlace principal por tarjeta (tienda > repo), más el devlog si existe.
const primaryLink = googlePlay
  ? { href: googlePlay, label: 'Descargar en Google Play' }
  : appStore
    ? { href: appStore, label: 'Descargar en App Store' }
    : steam
      ? { href: steam, label: 'Ver en Steam' }
      : repo
        ? { href: repo, label: 'Ver repositorio' }
        : null;
const devlogHref = devlog ? `${base}${devlog.replace(/^\//, '')}` : null;
const mediaSrc = (src: string) => `${base}${src.replace(/^\//, '')}`;
---
<article class:list={['project', featured && 'project-featured']}>
  <div class="project-media" data-product={project.slug}>
    {media ? (
      media.kind === 'video' ? (
        <PhoneVideo src={mediaSrc(media.src)} webm={media.webm && mediaSrc(media.webm)} poster={media.poster && mediaSrc(media.poster)} label={media.alt} />
      ) : (
        <div class="phone"><img src={mediaSrc(media.src)} alt={media.alt} loading="lazy" decoding="async" width="540" height="1098" /></div>
      )
    ) : (
      <div
        class="project-tile"
        role={progress ? 'img' : undefined}
        aria-label={progress ? `${title}: fase ${progress.current} de ${progress.total}, ${progress.label}` : undefined}
        aria-hidden={progress ? undefined : 'true'}
      >
        <b translate="no">{title.split(':')[0]}</b>
        {progress && (
          <>
            <ol class="tower" aria-hidden="true">
              {Array.from({ length: progress.total }, (_, i) => progress.total - i).map((floor) => (
                <li class:list={[floor <= progress.current && 'done', floor === progress.current && 'now']}></li>
              ))}
            </ol>
            <span>Fase {progress.current} de {progress.total}<br />{progress.label}</span>
          </>
        )}
      </div>
    )}
  </div>
  <div class="project-body">
    <p class="project-meta"><b>{categoryLabel[category]}</b> · {stack.join(' / ')}</p>
    <h3 translate="no">{title}</h3>
    <p><span class:list={['status', `status-${status}`]}>{statusLabel[status]}</span></p>
    <p class="project-desc">{description}</p>
    {(primaryLink || devlogHref) && (
      <p class="project-links">
        {primaryLink && <a class="text-link" href={primaryLink.href} rel="noopener">{primaryLink.label} →</a>}
        {devlogHref && <a class="text-link" href={devlogHref}>Leer el devlog →</a>}
      </p>
    )}
  </div>
</article>
