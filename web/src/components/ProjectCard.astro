---
import type { CollectionEntry } from 'astro:content';
import type { RepoStats } from '../lib/github';
import PhoneVideo from './PhoneVideo.astro';
import { localize, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  stats?: RepoStats | null;
  featured?: boolean;
  lang?: Lang;
  /** Nivel del título: h3 bajo una sección h2 (home), h2 si el listado cuelga directamente del h1. */
  headingLevel?: 'h2' | 'h3';
}
const { project, featured = false, lang = 'es', headingLevel: Heading = 'h3' } = Astro.props;
const t = ui[lang];
const { title, category, status, description, stack, media, progress, googlePlay, appStore, steam, repo, devlog, page } =
  localize(project.data, lang);
const base = import.meta.env.BASE_URL;

// Un enlace principal por tarjeta (tienda > repo), más el devlog si existe.
const primaryLink = googlePlay
  ? { href: googlePlay, label: t.project.googlePlay }
  : appStore
    ? { href: appStore, label: t.project.appStore }
    : steam
      ? { href: steam, label: t.project.steam }
      : repo
        ? { href: repo, label: t.project.repo }
        : null;
const pageHref = page ? `${base}${page.replace(/^\//, '')}` : null;
const devlogHref = devlog ? `${base}${devlog.replace(/^\//, '')}` : null;
const mediaSrc = (src: string) => `${base}${src.replace(/^\//, '')}`;
---
<article class:list={['project', featured && 'project-featured']}>
  <div class="project-media" data-product={project.slug}>
    {media ? (
      media.kind === 'video' ? (
        <PhoneVideo src={mediaSrc(media.src)} webm={media.webm && mediaSrc(media.webm)} poster={media.poster && mediaSrc(media.poster)} label={media.alt} lang={lang} />
      ) : (
        <div class="phone"><img src={mediaSrc(media.src)} alt={media.alt} loading="lazy" decoding="async" width="540" height="1098" /></div>
      )
    ) : (
      <div
        class="project-tile"
        role={progress ? 'img' : undefined}
        aria-label={progress ? `${title}: ${t.project.phase(progress.current, progress.total, progress.label)}` : undefined}
        aria-hidden={progress ? undefined : 'true'}
      >
        <b translate="no">{title.split(':')[0]}</b>
        {progress && (
          <>
            <ol class="tower" aria-hidden="true">
              {Array.from({ length: progress.total }, (_, i) => progress.total - i).map((floor) => (
                <li class:list={[floor <= progress.current && 'done', floor === progress.current && 'now']}></li>
              ))}
            </ol>
            <span>{t.project.phaseShort(progress.current, progress.total)}<br />{progress.label}</span>
          </>
        )}
      </div>
    )}
  </div>
  <div class="project-body">
    <p class="project-meta"><b>{t.category[category]}</b> · {stack.join(' / ')}</p>
    <Heading translate="no">{title}</Heading>
    <p><span class:list={['status', `status-${status}`]}>{t.status[status]}</span></p>
    <p class="project-desc">{description}</p>
    {(primaryLink || devlogHref || pageHref) && (
      <p class="project-links">
        {pageHref && <a class="text-link" href={pageHref}>{t.project.more(title.split(':')[0])}</a>}
        {primaryLink && <a class="text-link" href={primaryLink.href} rel="noopener">{primaryLink.label} →</a>}
        {devlogHref && <a class="text-link" href={devlogHref}>{t.project.readDevlog}</a>}
      </p>
    )}
  </div>
</article>
