---
// Wordmark del producto Parte. Úsalo SIEMPRE que "Parte" sea el nombre del
// producto, para que no se confunda con la palabra común "parte".
// No lo uses en <title>/meta (texto plano) ni para el uso común de la
// palabra (p. ej. "las partes" en terminos.astro).
interface Props {
  size?: 'inline' | 'lg';
}
const { size = 'inline' } = Astro.props;
---
<span class:list={['parte-mark', size === 'lg' && 'parte-mark-lg']} translate="no"><svg
    aria-hidden="true"
    viewBox="0 0 14 16"
    fill="none"
  ><path d="M1 1.5A.5.5 0 0 1 1.5 1H9l4 4v9.5a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5z" fill="currentColor"></path><path d="M9 1v4h4" fill="currentColor" opacity=".45"></path><path d="M3.5 8.5h7M3.5 11.5h4.5" stroke="var(--bg)" stroke-width="1.4" stroke-linecap="round"></path></svg>Parte</span>
