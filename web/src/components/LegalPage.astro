---
// Plantilla de páginas legales (políticas de apps, borrado de cuenta).
// Mismo marco visual que privacidad.astro / terminos.astro.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang, RouteKey } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  heading: string;
  description: string;
  /** Texto libre, p. ej. "01/10/2026". */
  updated?: string;
  noindex?: boolean;
  lang?: Lang;
  routeKey?: RouteKey;
}
const { title, heading, description, updated, noindex = true, lang = 'es', routeKey } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex} lang={lang} routeKey={routeKey}>
  <Header lang={lang} routeKey={routeKey} />
  <main id="main">
    <section class="legal">
      <div class="wrap">
        <div class="section-head">
          <h1>{heading}</h1>
          {updated && <span class="section-num mono">{ui[lang].legal.updated}: {updated}</span>}
        </div>
        <div class="legal-body"><slot /></div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
