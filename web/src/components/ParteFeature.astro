---
// Bloque compacto de Parte para la home. El pitch completo vive en /parte/.
import Parte from './Parte.astro';
import { parte, parteTrialHref } from '../lib/parte';
import { route, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const copy = parte[lang];
const en = lang === 'en';
---
<div class="parte-panel">
  <div>
    <Parte size="lg" />
    <p class="parte-tagline">{copy.tagline}</p>
    <p class="parte-for">{copy.audience} {copy.homeBlurb}</p>
  </div>
  <ol class="parte-steps">
    {copy.steps.map((step) => (
      <li>
        <div>
          <b>{step.title}</b>
          <p>{step.desc}</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="parte-actions">
    <a class="btn btn-parte" href={route('parte', lang)}><span>{en ? 'Learn about' : 'Conocer'} <span translate="no">Parte</span></span></a>
    <a class="text-link" href={parteTrialHref(route('home', lang), lang)}>{en ? 'Request early access →' : 'Pedir acceso anticipado →'}</a>
  </div>
</div>
