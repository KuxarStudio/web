---
// Bloque compacto de Parte para la home. El pitch completo vive en /parte/.
import Parte from './Parte.astro';
import { parteAudience, parteSteps, parteTagline, parteTrialHref } from '../lib/parte';
const base = import.meta.env.BASE_URL;
---
<div class="parte-panel">
  <div>
    <Parte size="lg" />
    <p class="parte-tagline">{parteTagline}</p>
    <p class="parte-for">{parteAudience} Conviertes las notas de una visita en un presupuesto listo para enviar, sin papeleo por la tarde.</p>
  </div>
  <ol class="parte-steps">
    {parteSteps.map((step) => (
      <li>
        <div>
          <b>{step.title}</b>
          <p>{step.desc}</p>
        </div>
      </li>
    ))}
  </ol>
  <div class="parte-actions">
    <a class="btn btn-parte" href={`${base}parte/`}><span>Conocer <span translate="no">Parte</span></span></a>
    <a class="text-link" href={parteTrialHref(base)}>Pedir acceso anticipado →</a>
  </div>
</div>
