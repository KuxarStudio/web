---
import type { CollectionEntry } from 'astro:content';
import type { RepoStats } from '../lib/github';
import { localize, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  tool: CollectionEntry<'tools'>;
  stats?: RepoStats | null;
  lang?: Lang;
  /** Nivel del título: h3 bajo una sección h2 (home), h2 si el listado cuelga directamente del h1. */
  headingLevel?: 'h2' | 'h3';
}
const { tool, stats, lang = 'es', headingLevel: Heading = 'h3' } = Astro.props;
const t = ui[lang].tool;
const { title, description, stack, installCmd, repo, releasesUrl } = localize(tool.data, lang);
---
<article class="tool">
  <p class="project-meta"><b>{t.label}</b> · {stack.join(' / ')}{stats && stats.stars > 0 && ` · ★ ${stats.stars}`}</p>
  <Heading>{title}</Heading>
  <p class="tool-desc">{description}</p>
  <code class="tool-cmd">{installCmd}</code>
  <div class="tool-actions">
    {releasesUrl && <a class="btn btn-secondary" href={releasesUrl} rel="noopener">{t.download}</a>}
    {repo && <a class="text-link" href={repo} rel="noopener">{t.code}</a>}
  </div>
</article>
