---
// Ficha de Kaku! reutilizable para ES y EN (misma estructura, copy en lib/kaku.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PhoneVideo from './PhoneVideo.astro';
import { kaku, kakuPaths, KAKU_PLAY, type Lang } from '../lib/kaku';
import { route } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = kaku[lang];
const site = Astro.site!.origin;
const pageUrl = `${site}${kakuPaths[lang]}`;
const abs = (p: string) => `${site}${p}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    '@id': `${pageUrl}#app`,
    name: 'Kaku!',
    alternateName: lang === 'es' ? 'Kaku! - Escribir en japonés' : 'Kaku! - Write Japanese',
    description: copy.description,
    url: pageUrl,
    inLanguage: lang,
    operatingSystem: 'Android',
    applicationCategory: 'EducationalApplication',
    downloadUrl: KAKU_PLAY[lang],
    installUrl: KAKU_PLAY[lang],
    image: abs(lang === 'es' ? '/og-kaku.png' : '/og-kaku-en.png'),
    offers: [
      { '@type': 'Offer', name: lang === 'es' ? 'Hiragana y katakana' : 'Hiragana and katakana', price: '0', priceCurrency: 'EUR' },
      { '@type': 'Offer', name: 'Sensei Pass', description: lang === 'es' ? 'Desbloquea los kanji. Pago único.' : 'Unlocks kanji. One-time purchase.', price: '2.39', priceCurrency: 'EUR' },
    ],
    author: { '@id': `${site}/#organization` },
    publisher: { '@id': `${site}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: copy.sections.map((s) => ({
      '@type': 'Question',
      name: s.q,
      acceptedAnswer: { '@type': 'Answer', text: s.a.join(' ') },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.breadcrumbHome, item: `${site}${route('home', lang)}` },
      { '@type': 'ListItem', position: 2, name: 'Kaku!', item: pageUrl },
    ],
  },
];
// Vídeo con la interfaz en el idioma de la página (…-en.* para inglés).
const suffix = lang === 'en' ? '-en' : '';
const mediaSrc = (p: string) => `${import.meta.env.BASE_URL}${p.replace(/^\//, '')}`;
---
<BaseLayout
  title={copy.title}
  description={copy.description}
  lang={lang}
  ogImage={lang === 'es' ? 'og-kaku.png' : 'og-kaku-en.png'}
  routeKey="kaku"
  jsonLd={jsonLd}
>
  <Header lang={lang} routeKey="kaku" />
  <main id="main">
    <section class="section page-top" aria-labelledby="kaku-title">
      <div class="wrap kaku-hero">
        <div>
          <h1 id="kaku-title">{copy.h1}</h1>
          <p class="hero-sub">{copy.lead}</p>
          <p style="margin-top:24px">
            <a class="btn btn-primary" href={KAKU_PLAY[lang]} rel="noopener">{copy.cta}</a>
          </p>
        </div>
        <div class="project-media" data-product="kaku">
          <PhoneVideo
            src={mediaSrc(`/media/kaku-trazos${suffix}.mp4`)}
            webm={mediaSrc(`/media/kaku-trazos${suffix}.webm`)}
            poster={mediaSrc(`/media/kaku-poster${suffix}.webp`)}
            label={copy.videoAlt}
            lang={lang}
          />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="como-title">
      <div class="wrap">
        <div class="section-head"><h2 id="como-title">{copy.stepsHeading}</h2></div>
        <ol class="kaku-points">
          {copy.steps.map((s) => (<li><b>{s.title}</b><span>{s.desc}</span></li>))}
        </ol>
      </div>
    </section>

    {copy.sections.map((s) => (
      <section class="section" id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="wrap">
          <div class="section-head"><h2 id={`${s.id}-title`}>{s.q}</h2></div>
          {s.a.map((p) => <p class="kaku-answer">{p}</p>)}
        </div>
      </section>
    ))}

    <section class="section" aria-labelledby="mas-title">
      <div class="wrap">
        <div class="section-head"><h2 id="mas-title">{copy.moreHeading}</h2></div>
        <p class="project-links">
          {copy.moreLinks.map((l) => <a class="text-link" href={`${import.meta.env.BASE_URL}${l.href.replace(/^\//, '')}`}>{l.label} →</a>)}
        </p>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
