---
// Ficha de BlindNote reutilizable para ES y EN (misma estructura que la de Kaku!;
// copy en lib/blindnote.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { blindnote, blindnotePaths, BLINDNOTE_PLAY, type Lang } from '../lib/blindnote';
import { route } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = blindnote[lang];
const site = Astro.site!.origin;
const pageUrl = `${site}${blindnotePaths[lang]}`;
const play = BLINDNOTE_PLAY?.[lang] ?? null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    '@id': `${pageUrl}#app`,
    name: 'BlindNote',
    description: copy.description,
    url: pageUrl,
    inLanguage: lang,
    operatingSystem: 'Android',
    applicationCategory: 'GameApplication',
    ...(play ? { downloadUrl: play, installUrl: play } : {}),
    image: `${site}/media/blindnote-turno.webp`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    author: { '@id': `${site}/#organization` },
    publisher: { '@id': `${site}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: lang,
    mainEntity: copy.sections.map((s) => ({
      '@type': 'Question',
      name: s.q,
      acceptedAnswer: { '@type': 'Answer', text: s.a.join(' ') },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: copy.breadcrumbHome, item: `${site}${route('home', lang)}` },
      { '@type': 'ListItem', position: 2, name: 'BlindNote', item: pageUrl },
    ],
  },
];
const href = (p: string) => `${import.meta.env.BASE_URL}${p.replace(/^\//, '')}`;
---
<BaseLayout title={copy.title} description={copy.description} lang={lang} routeKey="blindnote" jsonLd={jsonLd}>
  <Header lang={lang} routeKey="blindnote" />
  <main id="main">
    <section class="section page-top" aria-labelledby="blindnote-title">
      <div class="wrap kaku-hero">
        <div>
          <h1 id="blindnote-title">{copy.h1}</h1>
          <p class="hero-sub">{copy.lead}</p>
          <p style="margin-top:24px">
            {play
              ? <a class="btn btn-primary" href={play} rel="noopener">{copy.cta}</a>
              : <span class="status" data-product="blindnote" style="background:var(--product-bg);color:var(--product-ink);font-size:0.95rem;padding:6px 14px">{copy.ctaSoon}</span>}
          </p>
        </div>
        <div class="project-media" data-product="blindnote">
          <div class="phone">
            <img src={href('/media/blindnote-turno.webp')} alt={copy.imageAlt} width="540" height="1098" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="como-title">
      <div class="wrap">
        <div class="section-head"><h2 id="como-title">{copy.stepsHeading}</h2></div>
        <ol class="kaku-points">
          {copy.steps.map((s) => (<li><b>{s.title}</b><span>{s.desc}</span></li>))}
        </ol>
      </div>
    </section>

    <section class="section" aria-labelledby="tematicas-title">
      <div class="wrap">
        <div class="section-head"><h2 id="tematicas-title">{copy.themesHeading}</h2></div>
        <ul class="kaku-points">
          {copy.themes.map((t) => (<li><b>{t}</b></li>))}
        </ul>
      </div>
    </section>

    {copy.sections.map((s) => (
      <section class="section" id={s.id} aria-labelledby={`${s.id}-title`}>
        <div class="wrap">
          <div class="section-head"><h2 id={`${s.id}-title`}>{s.q}</h2></div>
          {s.a.map((p) => <p class="kaku-answer">{p}</p>)}
        </div>
      </section>
    ))}

    <section class="section" aria-labelledby="legal-title">
      <div class="wrap">
        <div class="section-head"><h2 id="legal-title">{copy.legalHeading}</h2></div>
        <p class="project-links">
          {copy.legalLinks.map((l) => <a class="text-link" href={href(l.href)}>{l.label} →</a>)}
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="mas-title">
      <div class="wrap">
        <div class="section-head"><h2 id="mas-title">{copy.moreHeading}</h2></div>
        <p class="project-links">
          {copy.moreLinks.map((l) => <a class="text-link" href={href(l.href)}>{l.label} →</a>)}
        </p>
        <p class="kaku-answer" style="margin-top:16px"><small>{copy.trademark}</small></p>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
