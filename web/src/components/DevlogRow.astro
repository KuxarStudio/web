---
import type { CollectionEntry } from 'astro:content';
import { devlogPath, formatDate, type Lang } from '../i18n';

interface Props {
  entry: CollectionEntry<'devlog'> | CollectionEntry<'devlog-en'>;
  lang?: Lang;
}
const { entry, lang = 'es' } = Astro.props;
const date = entry.data.date;
---
<li class="log-item">
  <a class="log-link" href={devlogPath(entry.slug, lang)}>
    <span class="log-meta"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date, lang, 'short')}</time><br />{entry.data.project}</span>
    <span class="log-title">{entry.data.title}</span>
    <span class="log-excerpt">{entry.data.excerpt}</span>
  </a>
</li>
