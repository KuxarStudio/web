---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'devlog'>;
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL;
const date = entry.data.date;
const formattedDate = date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<li class="log-item">
  <a class="log-link" href={`${base}devlog/${entry.slug}/`}>
    <span class="log-meta"><time datetime={date.toISOString().slice(0, 10)}>{formattedDate}</time><br />{entry.data.project}</span>
    <span class="log-title">{entry.data.title}</span>
    <span class="log-excerpt">{entry.data.excerpt}</span>
  </a>
</li>
