---
import Logo from './Logo.astro';
import ContactForm from './ContactForm.astro';
import Parte from './Parte.astro';
import { route, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { getCollection } from 'astro:content';
import { guidesPage } from '../i18n/pages';
import { kanaSheets } from '../i18n/kanaSheets';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = ui[lang];
const home = route('home', lang);
const hasGuides = (await getCollection(lang === 'en' ? 'guides-en' : 'guides')).length > 0;
---
<footer class="site-footer" id={t.ids.contact}>
  <div class="wrap contact">
    <div class="contact-intro">
      <h2>{t.footer.title}</h2>
      {lang === 'en' ? (
        <p>A custom project, early access to <Parte />, or a question about our games and apps? Write to us and we will reply by email.</p>
      ) : (
        <p>Un proyecto a medida, acceso anticipado a <Parte /> o una duda sobre nuestros juegos y apps. Te respondemos por email.</p>
      )}
      <p><a href="mailto:admin@kuxarstudio.com">admin@kuxarstudio.com</a></p>
    </div>
    <ContactForm fallback={false} lang={lang} />
  </div>

  <div class="wrap foot">
    <div class="foot-about">
      <a class="logo" href={home}><Logo class="logo-mark" />Kuxar Studio</a>
      <p>{t.footer.about}</p>
    </div>
    <nav class="foot-nav" aria-label={t.footer.nav}>
      <a href={route('kaku', lang)} translate="no">Kaku!</a>
      <a href={route('projects', lang)}>{t.footer.projects}</a>
      <a href={route('parte', lang)}><Parte /></a>
      <a href={route('tools', lang)}>{t.footer.tools}</a>
      <a href={route('devlog', lang)}>{t.footer.devlog}</a>
      {hasGuides && <a href={route('guides', lang)}>{guidesPage[lang].h1}</a>}
      {hasGuides && <a href={route('kanaSheets', lang)}>{kanaSheets[lang].breadcrumb}</a>}
      <a href={route('studio', lang)}>{t.footer.studio}</a>
      <a href="https://github.com/KuxarStudio" rel="noopener">GitHub</a>
    </nav>
    <div class="foot-bottom">
      <span>© 2026 Kuxar Studio</span>
      <nav aria-label={t.footer.legal}>
        <a href={route('privacy', lang)}>{t.footer.privacy}</a>
        <a href={route('terms', lang)}>{t.footer.terms}</a>
      </nav>
    </div>
  </div>
</footer>
