---
import Logo from './Logo.astro';
import ContactForm from './ContactForm.astro';
import Parte from './Parte.astro';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer" id="contacto">
  <div class="wrap contact">
    <div class="contact-intro">
      <h2>Escríbenos</h2>
      <p>Un proyecto a medida, acceso anticipado a <Parte /> o una duda sobre nuestros juegos y apps. Te respondemos por email.</p>
      <p><a href="mailto:admin@kuxarstudio.com">admin@kuxarstudio.com</a></p>
    </div>
    <ContactForm fallback={false} />
  </div>

  <div class="wrap foot">
    <div class="foot-about">
      <a class="logo" href={base}><Logo class="logo-mark" />Kuxar Studio</a>
      <p>Estudio de software independiente. Juegos, apps de aprendizaje, herramientas y software para empresas.</p>
    </div>
    <nav class="foot-nav" aria-label="Pie de página">
      <a href={`${base}portfolio/`}>Proyectos</a>
      <a href={`${base}kaku/`} translate="no">Kaku!</a>
      <a href={`${base}parte/`}><Parte /></a>
      <a href={`${base}herramientas/`}>Herramientas</a>
      <a href={`${base}devlog/`}>Devlog</a>
      <a href={`${base}#estudio`}>Estudio</a>
      <a href="https://github.com/KuxarStudio" rel="noopener">GitHub</a>
    </nav>
    <div class="foot-bottom">
      <span>© 2026 Kuxar Studio</span>
      <nav aria-label="Legal">
        <a href={`${base}privacidad/`}>Privacidad</a>
        <a href={`${base}terminos/`}>Términos</a>
      </nav>
    </div>
  </div>
</footer>
