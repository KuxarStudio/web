---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import ToolCard from '../ToolCard.astro';
import { getRepoStats } from '../../lib/github';
import type { Lang } from '../../i18n';
import { toolsPage } from '../../i18n/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = toolsPage[lang];
const allTools = await getCollection('tools');
const stats = await Promise.all(
  allTools.map((t) => (t.data.githubRepo ? getRepoStats(t.data.githubRepo) : Promise.resolve(null)))
);
---
<BaseLayout title={copy.title} description={copy.description} lang={lang} routeKey="tools">
  <Header lang={lang} routeKey="tools" />
  <main id="main">
    <section class="section page-top">
      <div class="wrap">
        <div class="section-head">
          <h1>{copy.h1}</h1>
          <p>{copy.intro}</p>
        </div>
        <div class="tools">
          {allTools.map((tool, i) => <ToolCard tool={tool} stats={stats[i]} lang={lang} />)}
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
