---
// Confirmación tras enviar el formulario de contacto. Existe como URL propia
// para poder medir la conversión (evento generate_lead en GA4 si hay
// consentimiento) y para no depender de un mensaje que desaparece al recargar.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { route, type Lang } from '../../i18n';
import { ui } from '../../i18n/ui';
interface Props { lang?: Lang }
const { lang = 'es' } = Astro.props;
const t = ui[lang].thanks;
---
<BaseLayout title={t.title} description={t.description} lang={lang} routeKey="thanks" noindex>
  <Header lang={lang} routeKey="thanks" />
  <main id="main">
    <section class="wrap not-found">
      <h1>{t.h1}</h1>
      <p>{t.body}</p>
      <div class="parte-actions">
        <a class="btn btn-primary" href={route('home', lang)}>{t.home}</a>
        <a class="text-link" href={route('projects', lang)}>{t.projects}</a>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <script>
    // gtag solo existe si el usuario aceptó las cookies (ver Analytics.astro).
    const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
    if (typeof gtag === 'function') gtag('event', 'generate_lead', { method: 'contact_form' });
  </script>
</BaseLayout>
