---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Parte from '../Parte.astro';
import { parte, parteTrialHref } from '../../lib/parte';
import { route, type Lang } from '../../i18n';
import { partePage } from '../../i18n/partePage';
import { ui } from '../../i18n/ui';
import { breadcrumbList } from '../../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = partePage[lang];
const shared = parte[lang];
const t = ui[lang];
const here = route('parte', lang);
const jsonLd = breadcrumbList(Astro.site!.origin, lang, [{ name: 'Parte', path: here }]);
const trialHref = parteTrialHref(here, lang);
const splitParte = (text: string) => text.split(/(\bParte\b)/);
---
<BaseLayout title={copy.title} description={copy.description} lang={lang} routeKey="parte" ogImage="og-parte.png" jsonLd={jsonLd}>
  <Header lang={lang} routeKey="parte" />

  <main id="main">
    <section class="parte-hero" aria-labelledby="parte-title">
      <div class="wrap parte-hero-grid">
        <div>
          <p class="parte-back"><a class="text-link" href={`${route('home', lang)}#${t.ids.business}`}>{copy.back}</a></p>
          <p class="parte-hero-mark"><Parte size="lg" /></p>
          <h1 id="parte-title">{shared.tagline}</h1>
          <p class="hero-sub">{shared.audience} {shared.heroBlurb}</p>
          <div class="parte-actions">
            <a class="btn btn-parte" href={trialHref}><span>{copy.requestAccess}</span></a>
            <a class="text-link" href="#como-funciona">{copy.howLink}</a>
          </div>
          <p class="parte-note">{copy.designNote}</p>
        </div>
        <section class="parte-panel parte-how" id="como-funciona" aria-labelledby="funciona-title">
          <h2 id="funciona-title">{copy.howTitle}</h2>
          <ol class="parte-steps">
            {shared.steps.map((step) => (
              <li>
                <div>
                  <b>{step.title}</b>
                  <p>{step.desc}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="parte-note">{copy.howNote}</p>
        </section>
      </div>
    </section>

    <section class="section" aria-labelledby="porque-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="porque-title">{copy.whyTitle}</h2>
        </div>
        <div class="parte-grid">
          {copy.points.map((point) => (
            <div class="parte-point">
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="probar-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="probar-title">{copy.interestedTitle}</h2>
          <p>{splitParte(copy.interestedText).map((part) => (part === 'Parte' ? <Parte /> : part))}</p>
        </div>
        <div class="parte-actions">
          <a class="btn btn-parte" href={trialHref}><span>{copy.requestAccess}</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
