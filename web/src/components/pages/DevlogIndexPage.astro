---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import DevlogRow from '../DevlogRow.astro';
import { devlogCollection } from '../../lib/devlog';
import type { Lang } from '../../i18n';
import { devlogPage } from '../../i18n/pages';

interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = devlogPage[lang];
const entries = await devlogCollection(lang);
---
<BaseLayout title={copy.title} description={copy.description} lang={lang} routeKey="devlog">
  <Header lang={lang} routeKey="devlog" />
  <main id="main">
    <section class="section page-top">
      <div class="wrap">
        <div class="section-head">
          <h1>{copy.h1}</h1>
          <p>{copy.intro}</p>
        </div>
        <ul class="log-list">
          {entries.map((entry) => <DevlogRow entry={entry} lang={lang} />)}
        </ul>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
