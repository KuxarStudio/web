---
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'work'>;
  featured?: boolean;
}
const { work, featured = false } = Astro.props;
const { title, client, description, stack, image, status, demoUrl, demoNote } = work.data;
const base = import.meta.env.BASE_URL;

const statusLabel: Record<string, string> = {
  entregado: 'Entregado y en producción',
  'en-desarrollo': 'En desarrollo',
};

const imgSrc = `${base}${image.src.replace(/^\//, '')}`;
---
<article class:list={['work', featured && 'work-featured']}>
  <div class="work-media">
    <div class="browser">
      <img src={imgSrc} alt={image.alt} loading="lazy" decoding="async" width="960" height="263" />
    </div>
  </div>
  <div class="work-body">
    <p class="project-meta"><b>Software a medida</b> · {client} · {stack.join(' / ')}</p>
    <h3>{title}</h3>
    <p><span class:list={['status', status === 'entregado' && 'status-disponible']}>{statusLabel[status]}</span></p>
    <p class="project-desc">{description}</p>
    {demoUrl && (
      <p class="project-links">
        <a class="text-link" href={demoUrl} rel="noopener">Ver demo →</a>
        {demoNote && <span class="work-demo-note">({demoNote})</span>}
      </p>
    )}
  </div>
</article>
