---
import type { CollectionEntry } from 'astro:content';
import { localize, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  work: CollectionEntry<'work'>;
  featured?: boolean;
  lang?: Lang;
}
const { work, featured = false, lang = 'es' } = Astro.props;
const t = ui[lang];
const { title, client, description, stack, image, status, demoUrl, demoNote } = localize(work.data, lang);
const base = import.meta.env.BASE_URL;

const imgSrc = `${base}${image.src.replace(/^\//, '')}`;
---
<article class:list={['work', featured && 'work-featured']}>
  <div class="work-media">
    <div class="browser">
      <img src={imgSrc} alt={image.alt} loading="lazy" decoding="async" width="960" height="263" />
    </div>
  </div>
  <div class="work-body">
    <p class="project-meta"><b>{t.work.label}</b> · {client} · {stack.join(' / ')}</p>
    <h3>{title}</h3>
    <p><span class:list={['status', status === 'entregado' && 'status-disponible']}>{t.workStatus[status]}</span></p>
    <p class="project-desc">{description}</p>
    {demoUrl && (
      <p class="project-links">
        <a class="text-link" href={demoUrl} rel="noopener">{t.work.demo}</a>
        {demoNote && <span class="work-demo-note">({demoNote})</span>}
      </p>
    )}
  </div>
</article>
