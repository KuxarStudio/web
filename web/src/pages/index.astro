---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DevlogRow from '../components/DevlogRow.astro';
import ToolCard from '../components/ToolCard.astro';
import SolutionCard from '../components/SolutionCard.astro';
import { solutions } from '../data/solutions';
import { getRepoStats } from '../lib/github';

const base = import.meta.env.BASE_URL;

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const featuredStats = await Promise.all(
  featuredProjects.map((p) => (p.data.githubRepo ? getRepoStats(p.data.githubRepo) : Promise.resolve(null)))
);

const allDevlog = (await getCollection('devlog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestDevlog = allDevlog.slice(0, 3);

const tools = await getCollection('tools');
const toolStats = await Promise.all(
  tools.map((t) => (t.data.githubRepo ? getRepoStats(t.data.githubRepo) : Promise.resolve(null)))
);
---
<BaseLayout
  title="Kuxar Studio — soluciones de IA para empresas"
  description="Estudio de software que diseña e implementa soluciones de IA a medida para empresas: automatización, datos, ventas y atención al cliente. Construido con el mismo oficio con el que hacemos nuestros propios productos."
>
  <Header />

  <main>
  <div id="top" class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Estudio de software · Soluciones IA para empresas</p>
        <h1 id="typed">Convertimos procesos manuales en software que funciona solo.</h1>
        <p class="lede">Diseñamos e implementamos soluciones de IA a medida para empresas — desde agentes que automatizan tareas internas hasta productos propios listos para vender. Cada proyecto, construido con el mismo oficio con el que hacemos nuestros juegos y herramientas.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contacto" data-magnetic>Hablemos de tu proceso</a>
          <a class="btn btn-ghost" href="#soluciones" data-magnetic>Ver soluciones</a>
        </div>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
          <span class="term-title">kuxar@studio:~$ cat ficha.json<span class="term-cursor"></span></span>
        </div>
        <div class="term-body">
          <div class="term-line"><span>enfoque</span><b>Soluciones IA para empresas</b></div>
          <div class="term-line"><span>método</span><b>Producto propio + trabajo a medida</b></div>
          <div class="term-line"><span>stack</span><b>IA aplicada · Automatización · Python</b></div>
          <div class="term-line"><span>banco de pruebas</span><b>Godot · Flutter (productos propios)</b></div>
          <div class="term-line"><span>sede</span><b>Internet-based</b></div>
        </div>
      </div>
    </div>
  </div>

  <section id="soluciones">
    <div class="wrap">
      <div class="section-head"><h2>Soluciones para empresas</h2><span class="section-num mono">01 — SOLUCIONES</span></div>
      <p class="section-intro">Trabajamos de dos formas: productos propios que resuelven un problema hiperespecífico de un sector, y desarrollo a medida bajo pedido cuando el problema es tuyo. Esto es lo que sabemos construir:</p>
      <div class="grid">
        {solutions.map((solution, i) => <SolutionCard solution={solution} index={i} />)}
      </div>
      <div class="solution-closing">
        <p>Hacemos productos propios y trabajamos bajo pedido — si tienes un problema concreto, hablemos.</p>
        <a class="btn btn-primary" href="#contacto" data-magnetic>Hablemos de tu proyecto</a>
      </div>
    </div>
  </section>

  <section id="portfolio">
    <div class="wrap">
      <div class="section-head"><h2>Cómo construimos</h2><span class="section-num mono">02 — PRUEBA DE OFICIO</span></div>
      <p class="section-intro">Juegos, apps y herramientas propias — la prueba de que sabemos llevar software desde la idea hasta producción con el mismo cuidado que ponemos en el trabajo para clientes.</p>
      <div class="grid">
        {featuredProjects.map((project, i) => <ProjectCard project={project} stats={featuredStats[i]} />)}
      </div>
      <div class="view-all"><a href={`${base}portfolio/`}>Ver archivo completo →</a></div>
    </div>
  </section>

  <section id="devlog" style="background:var(--paper-2);border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);">
    <div class="wrap">
      <div class="section-head" style="border-color:var(--ink);"><h2>Devlog</h2><span class="section-num mono">03 — BITÁCORA</span></div>
      <div class="log-list">
        {latestDevlog.map((entry) => <DevlogRow entry={entry} />)}
      </div>
      <div class="view-all"><a href={`${base}devlog/`}>Ver bitácora completa →</a></div>
    </div>
  </section>

  <section id="herramientas">
    <div class="wrap">
      <div class="section-head"><h2>Herramientas</h2><span class="section-num mono">04 — HERRAMIENTAS</span></div>
      {tools.map((tool, i) => <ToolCard tool={tool} stats={toolStats[i]} />)}
      <div class="ghost-card">+ Más herramientas en camino</div>
      <div class="view-all"><a href={`${base}herramientas/`}>Ver todas las herramientas →</a></div>
    </div>
  </section>
  </main>

  <Footer />

  <script>
    const el = document.getElementById('typed')!;
    const full = 'Convertimos procesos manuales en software que funciona solo.';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      el.textContent = full;
    } else {
      el.textContent = '';
      let i = 0;
      const tick = () => {
        el.textContent = full.slice(0, i);
        if (i < full.length) {
          i++;
          setTimeout(tick, 26);
        } else {
          el.innerHTML = full + '<span class="cur"></span>';
        }
      };
      tick();
    }
  </script>
</BaseLayout>
