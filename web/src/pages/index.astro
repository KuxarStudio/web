---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DevlogRow from '../components/DevlogRow.astro';
import ToolCard from '../components/ToolCard.astro';
import ParteFeature from '../components/ParteFeature.astro';
import { getRepoStats } from '../lib/github';

const base = import.meta.env.BASE_URL;

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
const featuredStats = await Promise.all(
  featuredProjects.map((p) => (p.data.githubRepo ? getRepoStats(p.data.githubRepo) : Promise.resolve(null)))
);

const allDevlog = (await getCollection('devlog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestDevlog = allDevlog.slice(0, 3);

const tools = await getCollection('tools');
const toolStats = await Promise.all(
  tools.map((t) => (t.data.githubRepo ? getRepoStats(t.data.githubRepo) : Promise.resolve(null)))
);
---
<BaseLayout
  title="Kuxar Studio — Parte, presupuestos para fontanería y reformas"
  description="Parte convierte las notas de una visita en un presupuesto profesional editable, para pymes de fontanería, instalaciones y reformas. Un SaaS de Kuxar Studio, estudio de software que construye productos propios y a medida."
>
  <Header />

  <main>
  <div id="top" class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Kuxar Studio · Parte, el SaaS para fontanería, instalaciones y reformas</p>
        <h1 id="typed">El presupuesto de la visita, antes de irte de la obra.</h1>
        <p class="lede">Dicta o escribe las notas de la visita, añade fotos si hace falta. Parte arma el presupuesto con tus tarifas y presupuestos anteriores, organiza materiales y mano de obra, y te pregunta lo que falte. Tú revisas precio, alcance y margen antes de enviarlo — nunca sale nada sin que lo veas.</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#contacto" data-magnetic>Quiero probarlo</a>
          <a class="btn btn-ghost" href="#soluciones" data-magnetic>Cómo funciona</a>
        </div>
      </div>
      <div class="term">
        <div class="term-bar">
          <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
          <span class="term-title">kuxar@studio:~$ cat ficha.json<span class="term-cursor"></span></span>
        </div>
        <div class="term-body">
          <div class="term-line"><span>producto</span><b>Parte — presupuestos de visita</b></div>
          <div class="term-line"><span>para</span><b>Fontanería · Instalaciones · Reformas</b></div>
          <div class="term-line"><span>modelo</span><b>Suscripción mensual</b></div>
          <div class="term-line"><span>revisión</span><b>Siempre humana antes de enviar</b></div>
          <div class="term-line"><span>sede</span><b>Internet-based</b></div>
        </div>
      </div>
    </div>
  </div>

  <section id="soluciones">
    <div class="wrap">
      <div class="section-head"><h2>Soluciones para empresas</h2><span class="section-num mono">01 — SOLUCIONES</span></div>
      <p class="section-intro">Empezamos con una solución concreta. Esta sección crece según construimos más — y si tu problema es distinto, también trabajamos a medida bajo pedido.</p>
      <ParteFeature />
      <div class="solution-closing">
        <p>¿Tienes un problema parecido en otro sector, o algo completamente distinto? Trabajamos bajo pedido — hablemos.</p>
        <a class="btn btn-primary" href="#contacto" data-magnetic>Hablemos de tu proyecto</a>
      </div>
    </div>
  </section>

  <section id="portfolio">
    <div class="wrap">
      <div class="section-head"><h2>Cómo construimos</h2><span class="section-num mono">02 — PRUEBA DE OFICIO</span></div>
      <p class="section-intro">Juegos, apps y herramientas propias — la prueba de que sabemos llevar software desde la idea hasta producción con el mismo cuidado que ponemos en el trabajo para clientes.</p>
      <div class="grid">
        {featuredProjects.map((project, i) => <ProjectCard project={project} stats={featuredStats[i]} />)}
      </div>
      <div class="view-all"><a href={`${base}portfolio/`}>Ver archivo completo →</a></div>
    </div>
  </section>

  <section id="devlog" style="background:var(--paper-2);border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);">
    <div class="wrap">
      <div class="section-head" style="border-color:var(--ink);"><h2>Devlog</h2><span class="section-num mono">03 — BITÁCORA</span></div>
      <div class="log-list">
        {latestDevlog.map((entry) => <DevlogRow entry={entry} />)}
      </div>
      <div class="view-all"><a href={`${base}devlog/`}>Ver bitácora completa →</a></div>
    </div>
  </section>

  <section id="herramientas">
    <div class="wrap">
      <div class="section-head"><h2>Herramientas</h2><span class="section-num mono">04 — HERRAMIENTAS</span></div>
      {tools.map((tool, i) => <ToolCard tool={tool} stats={toolStats[i]} />)}
      <div class="ghost-card">+ Más herramientas en camino</div>
      <div class="view-all"><a href={`${base}herramientas/`}>Ver todas las herramientas →</a></div>
    </div>
  </section>
  </main>

  <Footer />

  <script>
    const el = document.getElementById('typed')!;
    const full = 'El presupuesto de la visita, antes de irte de la obra.';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) {
      el.textContent = full;
    } else {
      el.textContent = '';
      let i = 0;
      const tick = () => {
        el.textContent = full.slice(0, i);
        if (i < full.length) {
          i++;
          setTimeout(tick, 26);
        } else {
          el.innerHTML = full + '<span class="cur"></span>';
        }
      };
      tick();
    }
  </script>
</BaseLayout>
