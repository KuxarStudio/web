---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolCard from '../components/ToolCard.astro';
import { getRepoStats } from '../lib/github';

const allTools = await getCollection('tools');
const stats = await Promise.all(
  allTools.map((t) => (t.data.githubRepo ? getRepoStats(t.data.githubRepo) : Promise.resolve(null)))
);
---
<BaseLayout
  title="Herramientas — Kuxar Studio"
  description="Todas las herramientas de Kuxar Studio: utilidades offline como PDF-Blender, con su stack y enlaces de descarga."
>
  <Header />
  <main>
  <section class="archive">
    <div class="wrap">
      <div class="section-head">
        <h1>Herramientas</h1>
        <span class="section-num mono">{allTools.length} HERRAMIENTAS</span>
      </div>
      <div class="tool-list" data-reveal-group>
        {allTools.map((tool, i) => <ToolCard tool={tool} stats={stats[i]} />)}
      </div>
    </div>
  </section>
  </main>
  <Footer />
</BaseLayout>
