---
import { getCollection } from 'astro:content';
import DevlogPostPage from '../../components/pages/DevlogPostPage.astro';
import type { Lang } from '../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('devlog');
  const translated = new Set((await getCollection('devlog-en')).map((e) => e.id));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, available: (translated.has(entry.id) ? ['es', 'en'] : ['es']) as Lang[] },
  }));
}
const { entry, available } = Astro.props;
---
<DevlogPostPage lang="es" entry={entry} available={available} />
