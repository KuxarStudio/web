---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { route } from '../i18n';
import { ui } from '../i18n/ui';

// GitHub Pages sirve este mismo 404.html para cualquier URL desconocida, así
// que el idioma solo se puede saber en el navegador: se pintan los dos
// bloques y un script enseña el de la ruta (/en/... = inglés).
const es = ui.es.notFound;
const en = ui.en.notFound;
---
<BaseLayout title={es.title} description={es.description} noindex>
  <Header />
  <main id="main">
    <section class="wrap not-found" data-lang="es">
      <h1>{es.h1}</h1>
      <p>La dirección <code data-path>que has abierto</code> no existe o se ha movido.</p>
      <div class="parte-actions">
        <a class="btn btn-primary" href={route('home', 'es')}>{es.home}</a>
        <a class="text-link" href={route('projects', 'es')}>{es.projects}</a>
      </div>
    </section>
    <section class="wrap not-found" data-lang="en" hidden>
      <h1>{en.h1}</h1>
      <p>The address <code data-path>you opened</code> does not exist or has moved.</p>
      <div class="parte-actions">
        <a class="btn btn-primary" href={route('home', 'en')}>{en.home}</a>
        <a class="text-link" href={route('projects', 'en')}>{en.projects}</a>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    const isEn = /^\/en(\/|$)/.test(window.location.pathname);
    document.querySelectorAll<HTMLElement>('[data-lang]').forEach((el) => {
      el.hidden = el.dataset.lang !== (isEn ? 'en' : 'es');
    });
    document.querySelectorAll('[data-path]').forEach((el) => {
      el.textContent = window.location.pathname;
    });
    if (isEn) {
      document.documentElement.lang = 'en';
      document.title = 'Page not found | Kuxar Studio';
    }
  </script>
</BaseLayout>
