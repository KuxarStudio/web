---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Página no encontrada | Kuxar Studio" description="Esta página no existe o se ha movido.">
  <Header />
  <main id="main">
    <section class="wrap not-found">
      <h1>No encontramos esta página</h1>
      <p>La dirección <code id="path">que has abierto</code> no existe o se ha movido.</p>
      <div class="parte-actions">
        <a class="btn btn-primary" href={base}>Ir al inicio</a>
        <a class="text-link" href={`${base}portfolio/`}>Ver proyectos →</a>
      </div>
    </section>
  </main>
  <Footer />
  <script>
    const pathEl = document.getElementById('path');
    if (pathEl) pathEl.textContent = window.location.pathname;
  </script>
</BaseLayout>
