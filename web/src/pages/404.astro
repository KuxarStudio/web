---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="404 — página no encontrada — Kuxar Studio" description="Esta página no existe o se ha movido.">
  <Header />
  <main>
  <section class="archive">
    <div class="wrap" style="max-width:640px;text-align:center;padding:60px 0 80px;">
      <h1 class="post-title">404 — página no encontrada</h1>
      <div class="term" style="text-align:left;display:inline-block;width:100%;margin-top:32px;">
        <div class="term-bar">
          <span class="term-dot"></span><span class="term-dot"></span><span class="term-dot"></span>
          <span class="term-title">kuxar@studio:~$ curl <span id="path">esta-página</span></span>
        </div>
        <div class="term-body">
          <div class="term-line"><span>status</span><b>404 Not Found</b></div>
          <div class="term-line"><span>razón</span><b>esta página no existe o se ha movido</b></div>
        </div>
      </div>
      <p class="lede" style="margin:32px auto 0;opacity:1;animation:none;">No hemos encontrado lo que buscabas. Puede que el enlace esté roto o que la página ya no exista.</p>
      <div class="cta-row" style="justify-content:center;opacity:1;animation:none;margin-top:28px;">
        <a class="btn btn-primary" href={base}>Volver al inicio</a>
        <a class="btn btn-ghost" href={`${base}portfolio.html`}>Ver portfolio</a>
      </div>
    </div>
  </section>
  </main>
  <Footer />
  <script>
    const pathEl = document.getElementById('path');
    if (pathEl) pathEl.textContent = window.location.pathname;
  </script>
</BaseLayout>
