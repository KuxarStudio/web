---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Parte from '../components/Parte.astro';
import { parteAudience, parteSteps, parteTagline, parteTrialHref } from '../lib/parte';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Parte | Presupuestos de obra desde el móvil · Kuxar Studio"
  ogImage="og-parte.png"
  description="Parte convierte las notas de una visita en un presupuesto profesional y editable, desde el móvil. Para pymes de fontanería, instalaciones y reformas. En diseño por Kuxar Studio."
>
  <Header />

  <main id="main">
    <section class="parte-hero" aria-labelledby="parte-title">
      <div class="wrap parte-hero-grid">
        <div>
          <p class="parte-back"><a class="text-link" href={`${base}#empresas`}>← Kuxar Studio para empresas</a></p>
          <p class="parte-hero-mark"><Parte size="lg" /></p>
          <h1 id="parte-title">{parteTagline}</h1>
          <p class="hero-sub">{parteAudience} Dictas las notas de la visita y te llevas el presupuesto hecho.</p>
          <div class="parte-actions">
            <a class="btn btn-parte" href={parteTrialHref(`${base}parte/`)}><span>Pedir acceso</span></a>
            <a class="text-link" href="#como-funciona">Cómo funciona →</a>
          </div>
          <p class="parte-note">En diseño. Modelo previsto: suscripción mensual.</p>
        </div>
        <section class="parte-panel parte-how" id="como-funciona" aria-labelledby="funciona-title">
          <h2 id="funciona-title">Cómo funciona</h2>
          <ol class="parte-steps">
            {parteSteps.map((step) => (
              <li>
                <div>
                  <b>{step.title}</b>
                  <p>{step.desc}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="parte-note">Todo desde el móvil, en la propia obra.</p>
        </section>
      </div>
    </section>

    <section class="section" aria-labelledby="porque-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="porque-title">Por qué lo hacemos</h2>
        </div>
        <div class="parte-grid">
          <div class="parte-point">
            <h3>Menos tardes de papeleo</h3>
            <p>El presupuesto sale de la visita, no de una sesión de oficina por la noche.</p>
          </div>
          <div class="parte-point">
            <h3>Menos partidas olvidadas</h3>
            <p>Te pregunta lo que falta o puede faltar, para que no quede trabajo sin cobrar.</p>
          </div>
          <div class="parte-point">
            <h3>Tus precios, no unos genéricos</h3>
            <p>Usa tus tarifas y tus presupuestos anteriores como punto de partida.</p>
          </div>
          <div class="parte-point">
            <h3>Tú tienes la última palabra</h3>
            <p>Revisas precio, alcance y margen antes de enviar. Nunca sale nada sin que lo veas.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="probar-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="probar-title">¿Te interesa?</h2>
          <p>Estamos diseñando <Parte /> con empresas de fontanería, instalaciones y reformas. Si quieres usarlo antes que nadie y contarnos cómo trabajas, pide acceso.</p>
        </div>
        <div class="parte-actions">
          <a class="btn btn-parte" href={parteTrialHref(`${base}parte/`)}><span>Pedir acceso</span></a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
