---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DevlogRow from '../components/DevlogRow.astro';

const allDevlog = (await getCollection('devlog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Devlog — Kuxar Studio"
  description="Notas de desarrollo de Kuxar Studio: decisiones de diseño y avances reales de Nadir, Kaku! y BlindNote, sin relleno."
>
  <Header />
  <section class="archive">
    <div class="wrap">
      <div class="section-head">
        <h1>Bitácora completa</h1>
        <span class="section-num mono">{allDevlog.length} ENTRADAS</span>
      </div>
      <div class="log-list">
        {allDevlog.map((entry) => <DevlogRow entry={entry} />)}
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
