---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DevlogRow from '../components/DevlogRow.astro';

const allDevlog = (await getCollection('devlog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout
  title="Devlog | Kuxar Studio"
  description="Notas de desarrollo de Kuxar Studio: decisiones y avances reales de Nadir, Kaku! y BlindNote."
>
  <Header />
  <main id="main">
    <section class="section page-top">
      <div class="wrap">
        <div class="section-head">
          <h1>Devlog</h1>
          <p>Cómo avanzan los proyectos, contado por quienes los hacen.</p>
        </div>
        <ul class="log-list">
          {allDevlog.map((entry) => <DevlogRow entry={entry} />)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
